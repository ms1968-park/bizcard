# .env.local 로 복사해서 값을 채우세요. (.env.local 은 Git에 올라가지 않습니다)

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Gemini (Google AI Studio > API Keys) - 서버 전용, NEXT_PUBLIC_ 을 붙이지 마세요
GEMINI_API_KEY=xxxx
# 선택: 글자 읽기 모델 바꾸기 (기본값 gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
